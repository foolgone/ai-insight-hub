# ===================================
# AI Insight Hub - 前端环境变量配置
# ===================================

# API 配置
# 留空则使用相对路径 /api/v1，由 vite.config.js 的代理转发到 http://localhost:8000
# 仅在前后端不同域部署时才需要填写完整地址（如 https://api.example.com/api/v1）
VITE_API_URL=
VITE_API_TIMEOUT=30000

# 应用配置
VITE_APP_NAME=AI Insight Hub
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# 功能开关
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_ANALYTICS=false

# 分页配置
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# 文件上传配置
VITE_MAX_UPLOAD_SIZE_MB=50
VITE_ALLOWED_FILE_TYPES=.csv,.json,.xlsx,.txt

# 第三方服务 (可选)
# Sentry 错误追踪（T7）：留空 = 关闭；填 DSN 后运行时错误 / ErrorBoundary 异常自动上报
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Google Analytics (可选)
# VITE_GA_TRACKING_ID=your-ga-tracking-id
