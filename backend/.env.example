# ===================================
# AI Insight Hub - 后端环境变量配置
# 复制为 backend/.env 后按需修改；本文件是配置项的事实源，必须与 app/core/config.py 一一对应
# ===================================

# 应用配置
APP_NAME="AI Insight Hub"
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# API 配置
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 数据库配置（与 docker-compose.yml 的 POSTGRES_USER/POSTGRES_DB 一致）
DATABASE_URL=postgresql://aiinsight:dev_password@localhost:5432/aiinsight
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis 配置
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# AI 服务配置（DeepSeek V4.1 Flash，langchain-deepseek 官方集成）
# 获取 API Key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可观测（自建：Loguru + 数据库调用记录 + Prometheus；不使用 LangSmith SaaS）
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LLM_CALL_LOG_ENABLED=true
PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics

# 文件存储配置 (MinIO/S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_UPLOADS=aiinsight-uploads
MINIO_BUCKET_REPORTS=aiinsight-reports
MINIO_USE_SSL=false

# AWS S3 (生产环境替代 MinIO)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=aiinsight-prod

# JWT 配置（唯一来源；不要再单独定义 SECRET_KEY）
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 成本控制
DAILY_COST_LIMIT=100.0
MONTHLY_COST_LIMIT=3000.0
COST_ALERT_THRESHOLD=0.8

# Agent 配置（模型 id 由配置决定，业务代码不写死）
DEFAULT_LLM_MODEL=deepseek-v4.1-flash
DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=4096
DEFAULT_TIMEOUT=60

# 成本核算单价（USD / 百万 token）
# ⚠️ 必须按 DeepSeek 官方定价填入；0 表示未配置（成本计算会告警）
LLM_PRICE_INPUT_PER_MTOK=0.0
LLM_PRICE_OUTPUT_PER_MTOK=0.0
# 成本超限时的降级模型（留空表示不启用降级）
DEGRADED_LLM_MODEL=

# Celery (异步任务队列)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 邮件配置 (可选，用于告警通知)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@aiinsight.com

# Sentry (可选，错误追踪)
# SENTRY_DSN=your-sentry-dsn

# 速率限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# 文件上传限制
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=csv,json,xlsx,txt
