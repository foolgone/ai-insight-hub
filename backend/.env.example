# ===================================
# AI Insight Hub - 后端环境变量配置
# ===================================

# 应用配置
APP_NAME="AI Insight Hub"
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
ENVIRONMENT=development

# API 配置
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 数据库配置
DATABASE_URL=postgresql://aiinsight:dev_password@localhost:5432/aiinsight
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis 配置
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# AI 服务配置
# 获取 API Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LangSmith (可选，用于调试和监控)
# 获取 API Key: https://smith.langchain.com/
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=ai-insight-hub
LANGSMITH_TRACING_V2=true

# 文件存储配置 (MinIO/S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_UPLOADS=aiinsight-uploads
MINIO_BUCKET_REPORTS=aiinsight-reports
MINIO_USE_SSL=false

# AWS S3 (生产环境替代 MinIO)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=aiinsight-prod

# JWT 配置
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 成本控制
DAILY_COST_LIMIT=100.0
MONTHLY_COST_LIMIT=3000.0
COST_ALERT_THRESHOLD=0.8

# Agent 配置
DEFAULT_LLM_MODEL=claude-sonnet-5-5
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=4096
DEFAULT_TIMEOUT=60

# Celery (异步任务队列)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 邮件配置 (可选，用于告警通知)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@aiinsight.com

# Sentry (可选，错误追踪)
# SENTRY_DSN=your-sentry-dsn

# 速率限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# 文件上传限制
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=csv,json,xlsx,txt
