# ===================================
# AI Insight Hub - 后端环境变量配置
# 复制为 backend/.env 后按需修改；本文件是配置项的事实源，必须与 app/core/config.py 一一对应
# ===================================

# 应用配置
APP_NAME="AI Insight Hub"
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# API 配置
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 数据库配置
# 默认：本地虚拟机里的 Docker 数据库（见 docs/00-本地VM数据库接入.md）
#   - VM 内 aiinsight-postgres 容器（pgvector/pgvector:pg14）映射到宿主 5433
#   - VM 的 5432 已被其它项目的 medical_pgvector 占用，本项目固定用 5433
# 备选：若改用本机 docker-compose.yml，则填 localhost:5432
DATABASE_URL=postgresql://aiinsight:dev_password@192.168.150.100:5433/aiinsight
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis 配置（默认：本地 VM 内 aiinsight-redis 容器；备选本机 docker-compose 用 localhost:6379）
REDIS_URL=redis://192.168.150.100:6379/0
REDIS_MAX_CONNECTIONS=50

# AI 服务配置（DeepSeek V4.1 Flash，langchain-deepseek 官方集成）
# 获取 API Key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可观测（自建：Loguru + 数据库调用记录 + Prometheus；不使用 LangSmith SaaS）
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LLM_CALL_LOG_ENABLED=true
PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics

# Sentry 错误追踪（T7）：留空 = 完全关闭；生产填 DSN 后 5xx/未捕获异常自动上报
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# 0.0 = 只上报错误不采样性能；压测/生产按需调大（0.05~0.2）
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# 文件存储配置 (MinIO/S3)
# ⚠️ 本地 VM 上 minio 容器暂未启动（VM 的镜像加速源对 minio 返回 403），M2 前不阻塞
MINIO_ENDPOINT=192.168.150.100:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_UPLOADS=aiinsight-uploads
MINIO_BUCKET_REPORTS=aiinsight-reports
MINIO_USE_SSL=false
# 存储后端：auto（MinIO 不可用时回退本地）| minio | local
STORAGE_BACKEND=auto
# 本地回退目录（相对 backend 工作目录）
STORAGE_LOCAL_DIR=.storage/uploads

# AWS S3 (生产环境替代 MinIO)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=aiinsight-prod

# JWT 配置（唯一来源；不要再单独定义 SECRET_KEY）
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 认证 Cookie（T4：refresh token 只放 HttpOnly Cookie，不再返回响应体）
AUTH_COOKIE_NAME=aiih_refresh
AUTH_COOKIE_PATH=/api/v1/auth
# 生产（HTTPS）必须设为 True；本地开发 HTTP 用 False
AUTH_COOKIE_SECURE=False
# lax（默认，阻断跨站 POST 携带 Cookie）/ strict / none（需 HTTPS + Secure）
AUTH_COOKIE_SAMESITE=lax
# 跨子域部署时才需要设置，例如 .example.com
AUTH_COOKIE_DOMAIN=

# 成本控制
DAILY_COST_LIMIT=100.0
MONTHLY_COST_LIMIT=3000.0
COST_ALERT_THRESHOLD=0.8

# Agent 配置（模型 id 由配置决定，业务代码不写死）
# 2026-10-24 实测可用：deepseek-flash（deepseek-v4-pro 为高阶备选，本 MVP 不用）
DEFAULT_LLM_MODEL=deepseek-flash
DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=4096
DEFAULT_TIMEOUT=60

# 成本核算单价（USD / 百万 token）
# 必须按 DeepSeek 官方现价填写（0 表示未配置，成本恒 0 且降级不触发）
# 下列为 2026-10 官方价参考值；调价后请同步更新
LLM_PRICE_INPUT_PER_MTOK=0.27
LLM_PRICE_OUTPUT_PER_MTOK=1.10
# 成本超限时的降级模型（留空表示不启用降级）
DEGRADED_LLM_MODEL=

# 嵌入模型（sentence-transformers；离线时把 CACHE_DIR 指向本地模型目录）
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=

# Celery (异步任务队列，复用 VM 的 Redis 其它 db)
CELERY_BROKER_URL=redis://192.168.150.100:6379/1
CELERY_RESULT_BACKEND=redis://192.168.150.100:6379/2
# true = 同步执行（本地/测试无需 worker）；生产保持 false
CELERY_TASK_ALWAYS_EAGER=false

# 邮件配置 (可选，用于告警通知)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@aiinsight.com

# Sentry (可选，错误追踪)
# SENTRY_DSN=your-sentry-dsn

# 速率限制
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# 文件上传限制
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=csv,json,xlsx,txt

# ── BYOK：用户自带 LLM API Key ─────────────────────────────
BYOK_ENABLED=true
# 32 字节 base64；缺失/非法时拒绝保存与解密（fail closed）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# 仅开发/CI/E2E：无用户 Key 时回退服务端 DEEPSEEK_API_KEY；生产必须 false
ALLOW_SERVER_KEY_FALLBACK=true
# verify 端点限流（次/分钟/用户）
LLM_CREDENTIAL_VERIFY_PER_MINUTE=5
# demo 账号种子密码（迁移 011 使用；生产请用 Secrets 覆盖）
SEED_DEMO_PASSWORD=demo123
