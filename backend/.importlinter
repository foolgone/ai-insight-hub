# 分层依赖约束（import-linter）
#
# 真实分层（从外到内，上层可依赖下层）：
#   api → tasks → services → application → agents → repositories → ports → models → schemas → core
#
# 组合根 app.composition 不在分层栈里：装配代码天生知道所有实现。
#
# `ignore_imports` 是**显式登记的欠账**，不是永久豁免：
# 每修掉一条就从这里删一行；新增的越界会立刻 BROKEN。
#
# 运行：cd backend && lint-imports

[importlinter]
root_package = app
include_external_packages = False


[importlinter:contract:declared-layers]
name = 声明的分层结构（现存欠账显式豁免）
type = layers
layers =
    app.api
    app.tasks
    app.services
    app.application
    app.agents
    app.repositories
    app.ports
    app.models
    app.schemas
    app.core
# 欠账 1（已清）：service 曾直接持有 Celery 任务对象，现已迁到 app.composition.enqueue
ignore_imports =
# 欠账 2：agent 取 BYOK 凭据时直接依赖 credential_service（应下沉为端口）
    app.agents.base -> app.services.credential_service
# 欠账 3：core 里混了需要 models/schemas 的模块（分页参数、成本记录、归属校验）
    app.core.pagination -> app.schemas.base
    app.core.cost_tracker -> app.models
    app.core.ownership -> app.models


[importlinter:contract:http-layer-not-depended-on]
name = HTTP 层（app.api）不得被业务层依赖
type = forbidden
source_modules =
    app.services
    app.application
    app.agents
    app.tasks
    app.models
    app.schemas
    app.ports
    app.repositories
forbidden_modules =
    app.api


[importlinter:contract:data-layer-is-leaf]
name = models / schemas 不依赖上层
type = forbidden
source_modules =
    app.models
    app.schemas
forbidden_modules =
    app.api
    app.services
    app.application
    app.agents
    app.tasks
    app.repositories
    app.ports


[importlinter:contract:ports-are-inner]
name = 端口层（app.ports）不得依赖实现层
type = forbidden
source_modules =
    app.ports
forbidden_modules =
    app.api
    app.services
    app.application
    app.agents
    app.tasks


[importlinter:contract:repositories-are-inner]
name = 仓储层（app.repositories）不得依赖上层
type = forbidden
source_modules =
    app.repositories
forbidden_modules =
    app.api
    app.services
    app.application
    app.agents
    app.tasks
