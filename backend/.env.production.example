# ===================================
# AI Insight Hub - 生产环境变量模板（请复制为服务器上的 backend/.env）
# 用法：
#   1. 复制本文件为 backend/.env（服务器上，不入库）
#   2. 替换所有 CHANGE_ME / 占位值
#   3. 生成密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"
#   4. docker compose -f docker-compose.prod.yml up -d --build
# 注意：本文件只是模板，不得包含真实密钥；生产用 Secret 管理下发。
# ===================================

APP_NAME="AI Insight Hub"
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=production

API_V1_PREFIX=/api/v1
# 生产域名（按实际替换）
BACKEND_CORS_ORIGINS=["https://CHANGE_ME.example.com"]

# ---------------- 数据库 / Redis（compose 服务名） ----------------
DATABASE_URL=postgresql://aiinsight:CHANGE_ME_DB_PASSWORD@postgres:5432/aiinsight
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# ---------------- LLM（DeepSeek） ----------------
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_MODEL=deepseek-flash
DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=4096
DEFAULT_TIMEOUT=60

# 成本核算单价（USD / 百万 token）——必须按官方定价填写，否则成本/降级不生效
# 成本核算单价（USD / 百万 token；按 DeepSeek 官方现价填写，勿留 0）
LLM_PRICE_INPUT_PER_MTOK=0.27
LLM_PRICE_OUTPUT_PER_MTOK=1.10
DEGRADED_LLM_MODEL=

# ---------------- BYOK（用户自带 API Key） ----------------
BYOK_ENABLED=true
# 必须通过 Secrets Manager 注入；丢失则已存凭据不可恢复（Phase 1 单密钥）
CREDENTIAL_ENCRYPTION_KEY=
# 生产必须 false：无 Key 的用户得到 428，绝不回退服务端 Key
ALLOW_SERVER_KEY_FALLBACK=false
LLM_CREDENTIAL_VERIFY_PER_MINUTE=5
# demo 账号密码（迁移 011 使用；建议单独注入，不沿用仓库默认值）
SEED_DEMO_PASSWORD=

# ---------------- 嵌入模型（本地，无 Key） ----------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
# 离线部署：把模型目录挂载进容器并指向它
EMBEDDING_CACHE_DIR=

# ---------------- JWT / 认证 ----------------
JWT_SECRET_KEY=CHANGE_ME_RANDOM_48_BYTES
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

AUTH_COOKIE_NAME=aiih_refresh
AUTH_COOKIE_PATH=/api/v1/auth
# 生产 HTTPS 必须 True
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# 种子管理员（首次迁移前配置；密码哈希用 bcrypt 生成，勿填明文）
SEED_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
SEED_ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# ---------------- 可观测 ----------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LLM_CALL_LOG_ENABLED=true
PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_SEND_DEFAULT_PII=false

# ---------------- 成本控制（按业务预算调整） ----------------
DAILY_COST_LIMIT=5.0
MONTHLY_COST_LIMIT=100.0
COST_ALERT_THRESHOLD=0.8

# ---------------- 文件存储（MinIO） ----------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET_UPLOADS=aiinsight-uploads
MINIO_BUCKET_REPORTS=aiinsight-reports
MINIO_USE_SSL=false
STORAGE_BACKEND=auto
STORAGE_LOCAL_DIR=.storage/uploads

# ---------------- Celery ----------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# 生产必须 false（需 worker 运行）
CELERY_TASK_ALWAYS_EAGER=false

# ---------------- 限流 / 上传 ----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=csv,json,xlsx,txt

# ---------------- SMTP（可选，告警通知） ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
