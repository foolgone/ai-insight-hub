    {
      "item_key": "DOC-SAMPLE-001",
      "query": "退款申请提交后多久到账？",
      "gold_answer": "退款审核通过后 1-3 个工作日退回原支付渠道。",
      "gold_evidence": [
        {
          "document_id": "sample-doc-after-sale",
          "chunk_id": "sample-chunk-01",
          "evidence_text": "退款将在审核通过后 1-3 个工作日内退回原支付渠道，具体到账时间以银行或支付平台为准。",
          "page_number": 3,
          "metadata": {"section": "售后-退款"}
        }
      ],
      "category": "售后",
      "difficulty": "easy",
      "source": "doc:robot-backend",
      "split": "test",
      "metadata": {"synthetic": true}
    },
    {
      "item_key": "DOC-SAMPLE-002",
      "query": "电子发票可以开公司抬头吗？",
      "gold_answer": "可以，开票时填写公司名称与税号即可。",
      "gold_evidence": [
        {
          "document_id": "sample-doc-invoice",
          "chunk_id": "sample-chunk-02",
          "evidence_text": "支持开具企业电子发票：在开票信息中填写公司名称、纳税人识别号与接收邮箱即可。",
          "page_number": 5,
          "metadata": {"section": "发票"}
        }
      ],
      "category": "发票",
      "difficulty": "easy",
      "source": "doc:robot-backend",
      "split": "test",
      "metadata": {"synthetic": true}
    },
    {
      "item_key": "DOC-SAMPLE-003",
      "query": "修改收货地址后运费会变吗？",
      "gold_answer": "地址变更可能影响运费，系统会重新计算差额。",
      "gold_evidence": [
        {
          "document_id": "sample-doc-logistics",
          "chunk_id": "sample-chunk-03",
          "evidence_text": "发货前修改收货地址，系统将按新地址重新计算运费，产生差额时需补缴或原路退还。",
          "page_number": 7,
          "metadata": {"section": "物流"}
        }
      ],
      "category": "物流",
      "difficulty": "medium",
      "source": "doc:robot-backend",
      "split": "valid",
