    {
      "item_key": "DOC-SAMPLE-004",
      "query": "会员积分可以抵扣现金吗？",
      "gold_answer": "100 积分可抵扣 1 元，单笔最多抵扣订单金额的 30%。",
      "gold_evidence": [
        {
          "document_id": "sample-doc-member",
          "chunk_id": "sample-chunk-04",
          "evidence_text": "积分兑换比例为 100 积分抵 1 元，单笔订单最高抵扣金额为订单金额的 30%。",
          "page_number": 11,
          "metadata": {"section": "会员"}
        }
      ],
      "category": "会员",
      "difficulty": "medium",
      "source": "doc:robot-backend",
      "split": "test",
      "metadata": {"synthetic": true}
    },
    {
      "item_key": "DOC-SAMPLE-005",
      "query": "商品支持价保吗？",
      "gold_answer": "支持 7 天价保，需订单未申请过其他补偿。",
      "gold_evidence": [
        {
          "document_id": "sample-doc-price-protect",
          "chunk_id": "sample-chunk-05",
          "evidence_text": "签收后 7 天内同商品降价可申请价保，同一订单仅可申请一次且不能与其它补偿叠加。",
          "page_number": 2,
          "metadata": {"section": "价保"}
        }
      ],
      "category": "售后",
      "difficulty": "medium",
      "source": "doc:robot-backend",
      "split": "test",
      "metadata": {"synthetic": true}
    },
    {
      "item_key": "DOC-SAMPLE-006",
      "query": "批量导入商品失败怎么排查？",
      "gold_answer": "先检查模板列名与必填项，再查看失败原因文件。",
      "gold_evidence": [
        {
          "document_id": "sample-doc-import",
          "chunk_id": "sample-chunk-06",
          "evidence_text": "批量导入失败时下载失败明细，逐行核对模板列名、必填字段与编码格式（UTF-8）。",
          "page_number": 9,
          "metadata": {"section": "商品导入"}
        }
      ],
      "category": "操作",
      "difficulty": "hard",
      "source": "doc:robot-backend",
      "split": "train",
      "metadata": {"synthetic": true}
